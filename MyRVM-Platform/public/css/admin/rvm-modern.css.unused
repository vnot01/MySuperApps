/* RVM Modern Cards Styling */

.rvm-card {
    transition: all 0.3s ease;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    overflow: hidden;
}

.rvm-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    border-color: #007bff;
}

.rvm-card .card-body {
    padding: 1.5rem;
}

/* Connection Pulse Animation */
.connection-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 6px;
    animation: pulse 2s infinite;
}

.connection-pulse.connected {
    background-color: #28a745;
    box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
}

.connection-pulse.disconnected {
    background-color: #dc3545;
    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
}

.connection-pulse.unknown {
    background-color: #dc3545;
    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
}

@keyframes pulse {
    0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
    }
    70% {
        transform: scale(1);
        box-shadow: 0 0 0 10px rgba(40, 167, 69, 0);
    }
    100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
    }
}

/* System Metrics Styling */
.system-metrics {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border-radius: 10px;
    padding: 1rem;
    margin-bottom: 1rem;
    border: 1px solid #dee2e6;
}

.metric-item {
    text-align: center;
    padding: 0.5rem;
}

.metric-value {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    line-height: 1;
}

.metric-label {
    font-size: 0.75rem;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}

/* Time Display */
.time-display {
    font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', 'Courier New', monospace;
    font-weight: 600;
    color: #495057;
    background: #f8f9fa;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #e9ecef;
}

/* Status Badge */
.status-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

/* Pagination Controls */
.pagination-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.pagination-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid #dee2e6;
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: #6c757d;
}

.pagination-btn:hover:not(:disabled) {
    background: #f8f9fa;
    border-color: #007bff;
    color: #007bff;
    transform: translateY(-1px);
}

.pagination-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
}

/* Avatar Styling - ONLY for notification dropdown, NOT user profile */
.dropdown-notifications .avatar {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    font-size: 0.875rem;
    font-weight: 600;
}

.dropdown-notifications .avatar-sm {
    width: 2rem;
    height: 2rem;
    font-size: 0.75rem;
}

/* Avatar initial - ONLY for notification dropdown */
.dropdown-notifications .avatar-initial {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.bg-label-primary {
    background-color: #007bff;
}

.bg-label-success {
    background-color: #28a745 !important;
    color: #ffffff !important;
}

.bg-label-info {
    background-color: #17a2b8 !important;
    color: #ffffff !important;
}

.bg-label-warning {
    background-color: #ffc107 !important;
    color: #212529 !important;
}

.bg-label-secondary {
    background-color: #6c757d !important;
    color: #ffffff !important;
}

.bg-label-danger {
    background-color: #dc3545 !important;
    color: #ffffff !important;
}

/* Card Header Styling */
.card-header {
    background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    border-bottom: 1px solid #e9ecef;
}

/* Statistics Cards */
.statistics-card {
    background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    border: 1px solid #e9ecef;
    border-radius: 12px;
    transition: all 0.3s ease;
}

.statistics-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

/* Responsive Design */
@media (max-width: 768px) {
    .rvm-card {
        margin-bottom: 1rem;
    }
    
    .system-metrics {
        padding: 0.75rem;
    }
    
    .metric-value {
        font-size: 1rem;
    }
    
    .pagination-controls {
        flex-wrap: wrap;
    }
}

@media (max-width: 576px) {
    .rvm-card .card-body {
        padding: 1rem;
    }
    
    .system-metrics {
        padding: 0.5rem;
    }
    
    .metric-item {
        padding: 0.25rem;
    }
}

/* Loading Animation */
.loading-shimmer {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
    0% {
        background-position: -200% 0;
    }
    100% {
        background-position: 200% 0;
    }
}

/* Badge Styling */
.badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: 6px;
}

/* Dropdown Styling - ONLY for general dropdowns, NOT notification dropdown */
.dropdown-menu:not(.dropdown-notifications .dropdown-menu) {
    border: 1px solid #e9ecef;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    padding: 0.5rem 0;
    z-index: 9999 !important;
    position: absolute !important;
    top: 100% !important;
    left: auto !important;
    right: 0 !important;
    min-width: 200px;
    max-height: 300px;
    overflow-y: auto;
    transform: translateY(5px) !important;
}

/* Notification dropdown specific styling */
.dropdown-notifications .dropdown-menu {
    border: 0px solid #e9ecef;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    padding: 0;
    z-index: 9999 !important;
    position: absolute !important;
    top: 100% !important;
    left: auto !important;
    right: 0 !important;
    min-width: 280px;
    max-height: 450px;
    transform: translateY(5px) !important;
}

/* Notification dropdown list with scroll */
.dropdown-notifications .dropdown-notifications-list {
    max-height: 350px;
    overflow-y: auto;
}

/* Ensure footer is always visible */
.dropdown-notifications .dropdown-menu-footer {
    position: sticky;
    bottom: 0;
    background-color: white;
    border-top: 1px solid #e9ecef;
    z-index: 10;
}

/* Ensure user profile avatar is not affected */
.dropdown-user .avatar {
    width: auto !important;
    height: auto !important;
}

.dropdown-user .w-px-40 {
    width: 40px !important;
    height: 40px !important;
}

.dropdown-item {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    transition: all 0.2s ease;
}

.dropdown-item:hover {
    background-color: #f8f9fa;
    color: #007bff;
}

.dropdown-item i {
    width: 16px;
    text-align: center;
}

/* Button Styling */
.btn-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.2s ease;
}

.btn-icon:hover {
    background-color: #f8f9fa;
    transform: scale(1.1);
}

/* Dropdown Button Positioning */
.dropdown {
    position: relative !important;
    z-index: 1;
}

.dropdown-toggle {
    position: relative !important;
    z-index: 1;
}

.dropdown-toggle::after {
    display: none;
}

/* Ensure dropdown is visible */
.dropdown-menu.show {
    display: block !important;
    z-index: 9999 !important;
    position: absolute !important;
}

/* Fix for Bootstrap dropdown positioning */
.dropdown-menu[data-bs-popper] {
    top: 100% !important;
    left: auto !important;
    right: 0 !important;
    margin-top: 0.125rem !important;
}

/* Text Colors */
.text-primary { color: #007bff !important; }
.text-success { color: #28a745 !important; }
.text-info { color: #17a2b8 !important; }
.text-warning { color: #ffc107 !important; }
.text-danger { color: #dc3545 !important; }
.text-secondary { color: #6c757d !important; }

/* Background Colors */
.bg-primary { background-color: #007bff !important; }
.bg-success { background-color: #28a745 !important; }
.bg-info { background-color: #17a2b8 !important; }
.bg-warning { background-color: #ffc107 !important; }
.bg-danger { background-color: #dc3545 !important; }
.bg-secondary { background-color: #6c757d !important; }
